# Optional explicit backend API base URL (e.g., http://127.0.0.1:8000).
# Leave empty during local development to route /api and /health through
# Vite's development proxy configured in vite.config.js.
VITE_API_BASE_URL=

# Target backend URL used by the Vite development proxy for /api and /health.
# Defaults to http://127.0.0.1:8000 when unset.
VITE_PROXY_TARGET=http://127.0.0.1:8000
