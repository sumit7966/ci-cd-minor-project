# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cicd_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Connection URL (Constructed or overridden)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cicd_platform

# GitHub Actions API Telemetry Configuration
# Format: owner/repository_name (e.g., your-org/your-repo)
GITHUB_REPOSITORY=owner/repository_name

# GitHub Personal Access Token (classic or fine-grained with 'actions:read' / repo scope)
# Optional for public repositories; required for private repositories and higher rate limits
GITHUB_TOKEN=your_personal_access_token_here

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
